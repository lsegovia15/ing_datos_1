# Copiar a .env y completar con los datos de tu SQL Server.
# Requiere autenticacion SQL (usuario/contraseña), no Windows Authentication.
DB_SERVER=localhost
# 14330 = SQL Server de docker-compose.yml. Para tu SQL Server instalado normalmente es 1433.
DB_PORT=14330
# Para una instancia con nombre (ej. SQLEXPRESS) completar DB_INSTANCE y dejar DB_PORT vacio
DB_INSTANCE=
DB_USER=sa
DB_PASSWORD=Siam_Test_2026!
DB_NAME=SIAM
DB_TRUST_CERT=true

PORT=3000
